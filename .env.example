# Optional. Without a key the app runs in offline extractive mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Required for any shared deployment
JWT_SECRET=            # 32+ random chars: python -c "import secrets;print(secrets.token_hex(32))"
ALLOW_REGISTER=1       # set 0 after creating your accounts
RATE_LIMIT=120
# Postgres mode (leave empty for in-memory dev mode)
# DATABASE_URL=postgresql://qai_app:qai_app@postgres:5432/qai
